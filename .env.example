# Database
DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db

# Google OAuth
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=mock_github_client_id
GITHUB_CLIENT_SECRET=mock_github_client_secret

# IDP Config
IDP_ISSUER=https://auth.unsareport.org
IDP_PORT=3000
IDP_ALLOWED_ORIGINS=http://localhost:5173,https://slides.unsareport.org

# Token Lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Client redirect after auth
CLIENT_REDIRECT_URL=http://localhost:5173

# Admin API Key for key rotation
ADMIN_API_KEY=admin-secret-key-12345
