# Database — use localhost when running auth outside Docker, compose overrides to postgres:5432 internally
DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db

# Google OAuth
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=mock_github_client_id
GITHUB_CLIENT_SECRET=mock_github_client_secret

# IDP Config — dev uses Traefik single entrypoint http://localhost:9876 (mirrors k8s ingress path /api/auth)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_PORT=3000
IDP_ALLOWED_ORIGINS=http://localhost:9876

# Token Lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Client redirect after auth — dev single-port via Traefik
CLIENT_REDIRECT_URL=http://localhost:9876

# Admin API Key for key rotation
ADMIN_API_KEY=admin-secret-key-12345
